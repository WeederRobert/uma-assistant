# 复制为 .env 后填写；所有变量均可省略，省略时使用默认值

# ---- 服务 ----
UMA_PORT=8737
UMA_HOST=127.0.0.1
UMA_LOG_LEVEL=INFO

# ---- 知识库模块：DeepSeek（OpenAI 兼容）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 知识库模块：本地向量化 ----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# 无法访问 Hugging Face 时设置镜像
# HF_ENDPOINT=https://hf-mirror.com

# ---- 日程模块：BWiki 抓取 ----
# 服务器（cn=简中服, tw=繁中服, jp=日服）；繁中来源默认不启用
# UMA_EVENTS_SERVERS=cn,jp
# 请求最小间隔（秒）与缓存有效期（小时），0 表示每次都请求
# UMA_EVENTS_INTERVAL_SECONDS=1.5
# UMA_EVENTS_CACHE_HOURS=6

# ---- 赛道模块：master.mdb 赛事目录 + BWiki 赛道几何 ----
# 覆盖 master.mdb 路径（默认 data/mdb/master.mdb）
# UMA_RACES_MDB_PATH=
# 几何数据页、请求最小间隔（秒）与缓存有效期（小时）
# UMA_RACES_GEOMETRY_PAGE=Data:Course/jian data.json
# UMA_RACES_INTERVAL_SECONDS=1.5
# UMA_RACES_CACHE_HOURS=24
